{
  "name": "dev.atelierromeny.com",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --host",
    "build": "rm -f node_modules/.astro/data-store.json && astro build",
    "preview": "astro preview --host",
    "astro": "astro",
    "deploy": "bun run build && wrangler deploy --config dist/server/wrangler.json",
    "cf:preview": "astro build && wrangler dev --config dist/server/wrangler.json",
    "generate-types": "astro build && wrangler types --config dist/server/wrangler.json",
    "match-photos": "bun scripts/photo-matcher/server.ts",
    "apply-photos": "bun scripts/photo-matcher/apply.ts"
  },
  "dependencies": {
    "@astrojs/alpinejs": "1.0.0",
    "@astrojs/cloudflare": "14.3.3",
    "@astrojs/markdown-satteri": "0.4.2",
    "@fontsource-variable/roboto-condensed": "^5.3.0",
    "@fontsource/special-gothic-expanded-one": "^5.3.0",
    "@panzoom/panzoom": "^4.6.2",
    "@sveltia/cms": "^0.227.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/alpinejs": "^3.17.0",
    "alpinejs": "^3.17.4",
    "astro": "7.3.5",
    "astro-icon": "^1.2.0",
    "astro-pagefind": "^2.0.1",
    "satteri": "^0.10.5",
    "tailwindcss": "^4.3.3",
    "uuid": "^14.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@lexical/code": "^0.52.0",
    "@lexical/history": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@lexical/utils": "^0.52.0",
    "gray-matter": "^4.0.3",
    "lexical": "^0.52.0",
    "wrangler": "^4.147.0"
  }
}
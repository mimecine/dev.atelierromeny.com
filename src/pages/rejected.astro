---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { thumbnailOf, titleOf } from "@src/lib/works";

// Works not in any collection yet
const works = await getCollection("works");
const rejectedWorks = works.filter((work) => !work.data.collections?.length);
---
<Layout title="Unclassed Works" noindex>
  <section class="grid max-w-6xl mx-auto py-4">
    <div class="works-grid">
      {
        works.map((work) => (
            <div class="work-item h-full" data-key={work.id}>
          <a href={`/_works/${work.id}/`}>
              <div class="work-thumbnail-container">
                {thumbnailOf(work) && (
                  <Image
                    src={thumbnailOf(work)!}
                    alt={work.data.title || ""}
                    width={600}
                    class="work-thumbnail"
                  />
                ) || (
                  <div class="w-80 h-60 grid grid-cols-1 place-content-center">Image missing</div>
                )}
              </div>
              <div>
                {titleOf(work)}
                {work.data.year_start && `, ${work.data.year_start}`}
              </div>
          </a>
          <a href=`/admin/#/collections/works/entries/${work.id}` target="admin">[classify]</a>
            </div>
        ))
      }
    </div>
  </section>
</Layout>

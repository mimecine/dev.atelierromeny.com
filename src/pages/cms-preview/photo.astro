---
// Preview template for photos: mirrors src/pages/photos/[slug].astro.
import PreviewShell from "@components/PreviewShell.astro";
export const prerender = true;
---

<PreviewShell name="photo">
  <article class="w-full max-w-5xl mx-auto p-4">
    <figure>
      <img data-field-src="image" alt="" class="block w-auto h-auto max-w-full max-h-[80vh] mx-auto" />
      <figcaption class="pt-3 text-center">
        <span class="font-bold" data-field="title" data-placeholder="Title"></span>
        <span class="block text-sm italic text-gray-600 font-serif" data-field="caption"></span>
      </figcaption>
    </figure>
    <div class="prose prose-lg font-serif mx-auto pt-6" data-field-html="body"></div>
  </article>
</PreviewShell>

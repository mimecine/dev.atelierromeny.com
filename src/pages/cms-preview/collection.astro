---
// Preview template for collections: the text above the grid (src/pages/[collection]/index.astro).
// The works themselves aren't part of the entry, so a placeholder grid stands in for them.
import PreviewShell from "@components/PreviewShell.astro";
export const prerender = true;
---

<PreviewShell name="collection">
  <section class="grid w-full py-4">
    <div class="w-full max-w-6xl mx-auto">
      <h2 class="text-2xl font-bold pb-2" data-field="title" data-placeholder="Collection title"></h2>
      <div class="prose font-serif" data-field-html="body"></div>
    </div>
    <div class="works-grid">
      {Array.from({ length: 8 }).map(() => <div class="work-item"><div class="work-thumbnail-container bg-gray-200"></div></div>)}
    </div>
  </section>
</PreviewShell>

---
// Point out the four corners of a painting in a photo; the page straightens and crops it
// and saves the result as an extra photo of the work. A companion to Sveltia CMS (/admin/),
// the table view and the order page; code in src/admin-table/crop.ts.
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Straighten &amp; crop · Atelier Romeny admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="bar">
      <a class="back" href="/admin/" title="Back to Sveltia CMS">← CMS</a>
      <label class="field">
        Work
        <input id="work" list="works" placeholder="Type a title or number…" autocomplete="off" />
        <datalist id="works"></datalist>
      </label>
      <span class="spacer"></span>
      <span id="status" class="status"></span>
      <span id="backend" class="backend"></span>
    </header>
    <div id="host" class="host"></div>
    <script>
      import "../../admin-table/crop";
    </script>
  </body>
</html>

<style is:global>
  :root {
    --border: #e3e1dc;
    --head: #f6f5f2;
    --text: #1f1d1a;
    --muted: #8a857c;
    --accent: #2f5bd3;
    color-scheme: light;
    font: 13px/1.4 system-ui, -apple-system, "Segoe UI", sans-serif;
    color: var(--text);
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    background: #fff;
  }
  input {
    font: inherit;
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 8px 12px;
    background: var(--head);
    border-bottom: 1px solid var(--border);
  }
  .bar .back {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  .field {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
  }
  #work {
    width: 300px;
    color: var(--text);
  }
  .spacer {
    flex: 1;
  }
  .backend {
    color: var(--muted);
  }
  .status.error {
    color: #b91c1c;
  }
  .status.ok {
    color: #15803d;
  }
  .host {
    flex: 1;
    min-height: 0;
  }
</style>

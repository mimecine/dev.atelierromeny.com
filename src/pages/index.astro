---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import { loadSettings } from "@src/lib/settings";
import CollectionSection from "@components/sections/CollectionSection.astro";
import CarouselSection from "@components/sections/CarouselSection.astro";
import ImageSection from "@components/sections/ImageSection.astro";
import ContentSection from "@components/sections/ContentSection.astro";
import TagSection from "@components/sections/TagSection.astro";
import SelectedWorksSection from "@components/sections/SelectedWorksSection.astro";
import FeaturedWorkSection from "@components/sections/FeaturedWorkSection.astro";
import TextImageSection from "@components/sections/TextImageSection.astro";
import QuoteSection from "@components/sections/QuoteSection.astro";
import CallToActionSection from "@components/sections/CallToActionSection.astro";
import DividerSection from "@components/sections/DividerSection.astro";

// Sections are edited in the CMS: Settings > Home Sections
const { sections = [] } = loadSettings();
const components = {
  works: SelectedWorksSection,
  collection: CollectionSection,
  tag: TagSection,
  featured: FeaturedWorkSection,
  carousel: CarouselSection,
  image: ImageSection,
  textimage: TextImageSection,
  content: ContentSection,
  quote: QuoteSection,
  cta: CallToActionSection,
  divider: DividerSection,
} as const;
---

<Layout cmsPath="settings/entries/home">
  <div class="flex flex-col gap-8 pb-8">
    {
      sections
        .filter((section) => !section.hidden && section.type in components)
        .map((section) => {
          const Section = components[section.type as keyof typeof components];
          return <Section section={section} />;
        })
    }
  </div>
</Layout>

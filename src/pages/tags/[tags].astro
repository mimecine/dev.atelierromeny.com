---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import WorkCard from "@components/WorkCard.astro";
import { type CollectionEntry, getCollection } from "astro:content";
import { shortHash, getNavDigest } from "@src/lib/cache-key";
import { byTitle, hasImage } from "@src/lib/works";
import { TAG_SEPARATOR, tagIndex, tagPath, tagSlugsOf } from "@src/lib/tags";

// One page per tag, and one per pair of tags that some work actually has together.
// Any other combination (three or more, or no shared works) is filtered in the
// browser on /tags/?t=… — see tags/index.astro and the redirect in 404.astro.
export async function getStaticPaths() {
  const works = (await getCollection("works")).filter(hasImage);
  const navDigest = await getNavDigest();
  const combos = new Set<string>();
  for (const work of works) {
    const slugs = tagSlugsOf(work).sort();
    slugs.forEach((a, i) => {
      combos.add(a);
      for (const b of slugs.slice(i + 1)) combos.add(`${a}${TAG_SEPARATOR}${b}`);
    });
  }
  return [...combos].map((combo) => {
    const slugs = combo.split(TAG_SEPARATOR);
    const members = works.filter((w) => slugs.every((s) => tagSlugsOf(w).includes(s)));
    return {
      params: { tags: combo },
      props: { slugs, members, combos },
      cacheKey: shortHash(combo, navDigest, ...members.map((w) => `${w.id}:${w.digest}`).sort()),
    };
  });
}

interface Props {
  slugs: string[];
  members: CollectionEntry<"works">[];
  combos: Set<string>;
}

const { slugs, members, combos } = Astro.props;
const works = [...members].sort(byTitle);
const allTags = tagIndex(await getCollection("works", hasImage));
const label = (slug: string) => allTags.find((t) => t.slug === slug)?.label ?? slug;

// Where a combination lives: its own page when one was built, the browser filter otherwise.
const href = (s: string[]) => {
  const key = [...new Set(s)].sort().join(TAG_SEPARATOR);
  return combos.has(key) ? tagPath(s) : `/tags/?t=${[...new Set(s)].sort().join(",")}`;
};

// Tags that narrow this selection down, with how many of these works carry each.
const narrow = tagIndex(works)
  .filter((t) => !slugs.includes(t.slug) && t.count < works.length)
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));
const title = slugs.map(label).join(" + ");
---

<Layout
  title={title}
  description={`${title}: ${works.length} works by Edlef Romeny`}
  noindex
>
  <section class="grid max-w-6xl mx-auto py-4 gap-4">
    <nav class="tag-trail" aria-label="Selected tags">
      <a href="/tags/">All tags</a>
      {slugs.map((s) => (
        <span class="tag-chip tag-chip-active">
          {label(s)}
          {slugs.length > 1 && (
            <a href={href(slugs.filter((x) => x !== s))} aria-label={`Remove ${label(s)}`} title={`Remove ${label(s)}`}>×</a>
          )}
        </span>
      ))}
      <span class="tag-count">{works.length} {works.length === 1 ? "work" : "works"}</span>
    </nav>

    {narrow.length > 0 && (
      <details class="tag-narrow" open={slugs.length === 1 ? undefined : true}>
        <summary>Narrow down</summary>
        <ul>
          {narrow.map((t) => (
            <li><a class="tag-chip" href={href([...slugs, t.slug])}>{t.label} <span>{t.count}</span></a></li>
          ))}
        </ul>
      </details>
    )}

    <div class="works-grid">
      {works.map((work) => <WorkCard work={work} collection="works" />)}
    </div>
  </section>
</Layout>


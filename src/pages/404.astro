---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
---

<Layout title="Page not found">
  <section class="grid max-w-4xl mx-auto py-16 text-center gap-4">
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist.</p>
    <p><a href="/">Back to the homepage</a></p>
  </section>
</Layout>

<script is:inline>
  // Tag combinations without a page of their own (three or more tags, or tags no work
  // shares) are filtered in the browser on /tags/?t=…
  (() => {
    const m = location.pathname.match(/^\/tags\/([^/]+)\/?$/);
    if (m) location.replace(`/tags/?t=${m[1]}`);
  })();
</script>

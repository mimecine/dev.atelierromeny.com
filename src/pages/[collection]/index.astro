---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import { type CollectionEntry, getCollection, render } from "astro:content";
import WorkCard from "@components/WorkCard.astro";
import SearchMeta from "@components/SearchMeta.astro";
import { shortHash, getNavDigest } from "@src/lib/cache-key";
import { isMenuCollection } from "@src/lib/settings";
import { byTitle, hasImage, thumbnailOf } from "@src/lib/works";
import PhotoCard from "@components/PhotoCard.astro";
import { randomPhotos } from "@src/lib/photos";
import { loadSettings } from "@src/lib/settings";

export async function getStaticPaths() {
  let collections = await getCollection("collections",(col) => col.data.published !== false);
  const allWorks: CollectionEntry<"collections"> = {
    id: "_works",
    collection: "collections",
    data: { title: "Works" },
  };
  collections.push(allWorks);

  let works = (await getCollection("works")).filter(hasImage);
  const navDigest = await getNavDigest();

  return collections.map((collection) => {
    // The page also lists/sorts every work that belongs to this collection,
    // so its cacheKey must change if membership or any member's content
    // changes, not just when the collection's own file changes.
    const memberDigest = shortHash(
      ...works
        .filter(
          (work) =>
            work.data.collections?.includes(collection.id) ||
            collection.data.title === "Works"
        )
        .map((work) => `${work.id}:${work.digest}`)
        .sort()
    );
    return {
      params: { collection: collection.id },
      props: collection,
      cacheKey: shortHash(collection.digest, memberDigest, navDigest),
    };
  });
}

type Props = CollectionEntry<"collections">;

const collection = Astro.props;
const { Content } = await render(collection);

const works = (await getCollection("works",(work) => hasImage(work) && (work.data.collections?.includes(collection.id) ||
collection.data.title === "Works")))
  .sort(byTitle);

// Settings > Parameters > Photos: a random photo after every N works (not on _works,
// the all-works list, nor with ?detail debugging in mind).
const every = collection.id === "_works" ? 0 : loadSettings().photos_every ?? 0;
const photos = every ? await randomPhotos(Math.floor(works.length / every)) : [];
const items = works.flatMap((work, i) => {
  const photo = every && (i + 1) % every === 0 ? photos[(i + 1) / every - 1] : undefined;
  return photo ? [{ work, i }, { photo }] : [{ work, i }];
});
---

<Layout
  title={collection.data.title || undefined}
  cmsPath={collection.id === "_works" || collection.id === "works" ? "works" : `collections/entries/${collection.id}`}
  image={works[0] && thumbnailOf(works[0])}
  description={`${collection.data.title || "Works"}: ${works.length} works by Edlef Romeny`}
  searchable
  noindex={!isMenuCollection(collection.id)}
>
  <section class="grid max-w-6xl mx-auto py-4">
    <SearchMeta type="collection" title={collection.data.title || "Works"} />
    <Content />
    <div class="works-grid" data-pagefind-ignore data-detail-grid>
      {
        items.map((item) =>
          "photo" in item ? (
            item.photo && <PhotoCard photo={item.photo} />
          ) : (
            <WorkCard work={item.work} collection={collection.id} searchImage={item.i === 0} detailSrc />
          )
        )
      }
    </div>
  </section>
</Layout>

<script>
  // Debugging: with ?detail in the URL (e.g. /review-details/?detail) each card shows its
  // work's detail image (data-detail-src, rendered by WorkCard) instead of the thumbnail,
  // and works without a detail get a "no detail" badge. The page is static, so it's done here.
  const showDetails = () => {
    if (!new URLSearchParams(location.search).has("detail")) return;
    document
      .querySelectorAll<HTMLElement>("[data-detail-grid] .work-item:not([data-detail-view])")
      .forEach((item) => {
        item.dataset.detailView = "";
        const img = item.querySelector("img");
        const src = item.dataset.detailSrc;
        if (src && img) {
          img.removeAttribute("srcset");
          img.removeAttribute("sizes");
          img.src = src;
        } else item.dataset.detailView = "none";
      });
  };
  document.addEventListener("astro:page-load", showDetails);
</script>

<style>
  @reference "../../styles/global.css";

  [data-detail-grid] :global(.work-item[data-detail-view="none"] .work-thumbnail-container) {
    position: relative;
  }
  [data-detail-grid] :global(.work-item[data-detail-view="none"] .work-thumbnail-container::after) {
    content: "no detail";
    position: absolute;
    top: 0.25rem;
    left: 0.25rem;
    padding: 0 0.4rem;
    font-size: 0.7rem;
    line-height: 1.4;
    color: #fff;
    background: #b91c1c;
    border-radius: 0.25rem;
  }
</style>

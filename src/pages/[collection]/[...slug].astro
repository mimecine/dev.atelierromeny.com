---
export const prerender = true;
import {
  type CollectionEntry,
  getCollection,
  getEntry,
  render,
} from "astro:content";
import Layout from "@layouts/Layout.astro";
import WorkImages from "@components/WorkImages.astro";
import SearchMeta from "@components/SearchMeta.astro";
import Star from "@components/Star.astro";
import { shortHash, getNavDigest } from "@src/lib/cache-key";
import { workTransitionName } from "@src/lib/view-transition";
import { isMenuCollection } from "@src/lib/settings";
import { byTitle, hasImage, thumbnailOf, titleOf } from "@src/lib/works";


export async function getStaticPaths() {
  // (getStaticPaths runs on its own: it can't use helpers from the rest of the frontmatter)
  const isAllWorks = (id: string) => id === "works" || id === "_works";
  const collections = await getCollection("collections");
  // Two all-works contexts: /works/<slug>/ is each work's public, canonical address;
  // /_works/<slug>/ is the same page for browsing everything (never indexed).
  for (const id of ["works", "_works"]) {
    collections.push({ id, collection: "collections", data: { title: "Works" } } as any);
  }

  const works = await getCollection("works");
  const navDigest = await getNavDigest();

  return collections.flatMap((collection) => {
    const collectionWorks = works
      .filter(hasImage)
      .filter((work) =>
        work.data.collections?.includes(collection.id) ||
        isAllWorks(collection.id)
      )
      .sort((a, b) =>
        byTitle(a, b)
      );

    // Prev/next links and the "N of M" counter depend on the full ordered
    // sibling list, so fold everyone's digest into every page in the set.
    const siblingDigest = shortHash(
      ...collectionWorks.map((work) => `${work.id}:${work.digest}`)
    );

    return collectionWorks.map((work) => ({
      params: {
        collection: collection.id,
        slug: work.id,
      },
      props: { work, collection },
      cacheKey: shortHash(
        work.digest,
        collection.digest,
        siblingDigest,
        navDigest
      ),
    }));
  });

}

type Props = {
  collection: CollectionEntry<"collections">;
  work: CollectionEntry<"works">;
};
type Params = {
  collection: string;
  slug: string;
};
const { work, collection } = Astro.props;

const { Content } = await render(work);
const isAllWorks = (id: string) => id === "works" || id === "_works";
// The canonical /works/ page is indexed when the work is shown in a menu collection.
const inMenu = (work.data.collections ?? []).some(isMenuCollection);

const works = (await getCollection("works"))
  .filter(hasImage)
  .filter(
    (work) =>
      work.data.collections?.includes(collection.id || "") ||
      isAllWorks(collection.id)
  )
  .sort(
    byTitle
  );

console.log(
  "len",
  (await getCollection("works"))
    .filter(hasImage)
    .filter(
      (work) =>
        work.data.collections?.includes(collection.id || "") ||
        isAllWorks(collection.id)
    ).length
);

type Acc = {
  previous: CollectionEntry<"works"> | null;
  next: CollectionEntry<"works"> | null;
};
type AccCount = {
  count: number | null;
  index: number | null;
};
const { previous, next } = works.reduce(
  (acc: Acc, work, i) => {
    if (work.id === Astro.params.slug) {
      acc.previous = works[i - 1] || null;
      acc.next = works[i + 1] || null;
    }
    return acc;
  },
  { previous: null, next: null }
);
const { count, index } = works.reduce(
  (acc: AccCount, work, i) => {
    if (work.id === Astro.params.slug) {
      acc.count = works.length;
      acc.index = i;
    }
    return acc;
  },
  { count: 0, index: 0 }
);
---

<Layout
  title={titleOf(work)}
  cmsPath={`works/entries/${work.id}`}
  printInfo={[
    titleOf(work),
    work.data.year_start,
    work.data.w && work.data.h && `${work.data.w} × ${work.data.h} cm`,
  ].filter(Boolean).join(", ")}
  image={thumbnailOf(work)}
  description={[
    `Edlef Romeny, ${titleOf(work)}`,
    work.data.year_start,
    work.data.w && work.data.h && `${work.data.w} × ${work.data.h} cm`,
  ].filter(Boolean).join(", ")}
  bodyclasses="work-page"
  canonical={`/works/${work.id}/`}
  searchable={collection.id === "works"}
  noindex={collection.id === "works" ? !inMenu : !isMenuCollection(collection.id)}
>
  <section class="flex flex-col flex-1 min-h-0 w-full max-w-4xl mx-auto">
    <SearchMeta
      type="work"
      title={[titleOf(work), work.data.year_start].filter(Boolean).join(", ")}
    />
    <WorkImages work={work} transitionName={workTransitionName(collection.id, work.id)} />
    <!-- When printing, this line is printed beside the logo instead (printInfo above) -->
    <div class="work-info py-3 w-full text-center font-bold shrink-0 print:hidden">
      {titleOf(work)}{work.data.year_start && `, ${work.data.year_start}`}{work.data.year_start && work.data.year_end && `–${work.data.year_end}`}{work.data.w && work.data.h && ` (${work.data.w} × ${work.data.h} cm)`}
      <span class="print:hidden" data-pagefind-ignore x-data={`{ id: ${JSON.stringify(work.id)} }`}>
        <button
          type="button"
          class="icon-btn align-[-0.2em] ml-1.5"
          @click="$store.saved.toggle(id)"
          :aria-pressed="$store.saved.has(id)"
          :aria-label="$store.saved.has(id) ? 'Remove from saved' : 'Save'"
          :title="$store.saved.has(id) ? 'Remove from saved' : 'Save'"
        >
          <Star size={20} :class="$store.saved.has(id) && 'star-filled'" />
        </button>
      </span>
    </div>

    <ul class="grid grid-cols-3 w-full place-items-center uppercase shrink-0 print:hidden" data-pagefind-ignore x-data>
      <li>
        {
          previous && (
            <a
              @keyup.window.left="$el.click()"
              href={`/${collection.id}/${previous.id}`}
              title={previous.data.title}>
              <span class="text-black opacity-30">&larr;</span> Previous
            </a>
          )
        }
      </li>
      <li></li>
      <li>
        &nbsp;
        {
          next && (
            <a
              @keyup.window.right="$el.click()"
              href={`/${collection.id}/${next.id}`}
              title={next.data.title}>
              Next <span class="text-black opacity-30">&rarr;</span>
            </a>
          )
        }
      </li>
    </ul>
    <a href="./" @keyup.window.esc="$el.click()" class="hidden" data-pagefind-ignore
      >Back to collection</a
    >
  </section>
</Layout>

<style>
  @reference "../../styles/global.css";
  article {
    @apply p-4;
  }
  article img {
    max-width: 100%;
    height: auto;
    @apply border  object-contain;
  }
  article h1 {
    @apply text-2xl font-bold;
  }
</style>

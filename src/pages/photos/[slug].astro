---
// One photo (/photos/<slug>/): the photo, its caption and description.
export const prerender = true;
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import { Image, getImage } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import { publishedPhotos, type Photo } from "@src/lib/photos";

export const getStaticPaths = (async () => {
  const photos = await publishedPhotos();
  return photos.map((photo, i) => ({
    params: { slug: photo.id },
    props: { photo, previous: photos[i - 1], next: photos[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  photo: Photo;
  previous?: Photo;
  next?: Photo;
}
const { photo, previous, next } = Astro.props;
const { Content } = await render(photo);
const { title, image, caption, date } = photo.data;
const zoom = (await getImage({ src: image, width: Math.min(image.width, 3000) })).src;
const transitionName = `photo-${photo.id.replace(/[^a-zA-Z0-9_-]/g, "_")}`;
---

<Layout title={title} description={caption || undefined} image={image} cmsPath={`photos/entries/${photo.id}`}>
  <article class="w-full max-w-5xl mx-auto p-4">
    <figure>
      <Image
        src={image}
        alt={caption || title}
        width={2000}
        class="block w-auto h-auto max-w-full max-h-[80vh] mx-auto"
        data-zoom-src={zoom}
        style={`view-transition-name: ${transitionName}`}
      />
      <figcaption class="pt-3 text-center">
        <span class="font-bold">{title}</span>
        {caption && <span class="block text-sm italic text-gray-600 font-serif">{caption}</span>}
        {
          date && (
            <time class="block text-xs text-gray-500" datetime={date.toISOString().slice(0, 10)}>
              {date.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}
            </time>
          )
        }
      </figcaption>
    </figure>
    <div class="prose prose-lg font-serif mx-auto pt-6">
      <Content />
    </div>
    <nav class="grid grid-cols-3 place-items-center uppercase pt-8 print:hidden" aria-label="More photos" x-data>
      <span>
        {
          previous && (
            <a href={`/photos/${previous.id}/`} title={previous.data.title} @keyup.window.left="$el.click()">
              <span class="opacity-30">&larr;</span> Previous
            </a>
          )
        }
      </span>
      <a href="/photos/">All photos</a>
      <span>
        {
          next && (
            <a href={`/photos/${next.id}/`} title={next.data.title} @keyup.window.right="$el.click()">
              Next <span class="opacity-30">&rarr;</span>
            </a>
          )
        }
      </span>
    </nav>
  </article>
</Layout>

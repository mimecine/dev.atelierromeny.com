---
export const prerender = true;
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import SearchMeta from "@components/SearchMeta.astro";
import { type CollectionEntry, render, getEntry } from "astro:content";
import { shortHash, getNavDigest } from "@src/lib/cache-key";
const page = await getEntry("pages", String(Astro.params.slug));
if (!page) {
  throw new Error("Page not found");
}
const { Content } = await render(page as CollectionEntry<"pages">);
export const getStaticPaths: GetStaticPaths = async () => {
  const pages = await getCollection("pages");
  const navDigest = await getNavDigest();
  return pages.map((page) => ({
    params: { slug: page.id },
    cacheKey: shortHash(page.digest, navDigest),
  }));
};
const { title, image, note, tags, css, js} = page.data;
const layeredCss = `html, html#slug-${page.id}.slug-${page.id} {
  ${css}
}`;
---

<Layout title={title} slug={page.id} bodyclasses={`slug-${page.id}`} description={note} image={image} frontmatter={page.data} searchable={page.data.published}>
  <section class="grid max-w-4xl mx-auto py-4 font-serif">
    <SearchMeta type="page" title={title} />
    <div class="prose prose-lg w-full lg:w-4xl mx-auto [&>:first-child+*]:mt-0">
      {
        image && (
          <div class="not-prose float-right ml-4 mb-2 w-40 sm:w-52">
            <Image src={image} alt={title} width={420} class="w-full h-auto" data-pagefind-meta="image[src]" />
          </div>
        )
      }
      <Content />
    </div>
  </section>
</Layout>
<style>
  @reference '../styles/global.css';
</style>
{/* A page's own CSS (compiled in the browser, so @apply etc. work) and JS, only when set */}
{css && <script is:inline src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>}
{css && <style is:inline set:html={layeredCss} type="text/tailwindcss" />}
{js && <script is:inline set:html={js} />}
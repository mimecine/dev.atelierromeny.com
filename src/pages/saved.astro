---
export const prerender = true;
import Layout from "@layouts/Layout.astro";
import Star from "@components/Star.astro";
---

<Layout title="Saved works" noindex>
  <section class="grid max-w-6xl mx-auto py-4" x-data="savedList()" x-init="init()">
    <h1 class="print:hidden">Saved works</h1>
    <p x-cloak x-show="!loading && items.length === 0" class="text-gray-500">
      You haven't saved any works yet.
    </p>
    <div class="works-grid">
      <template x-for="item in items" :key="item.id">
        <div
          class="work-item relative"
          x-show="!removing.includes(item.id)"
          x-transition:leave="transition ease-in duration-300"
          x-transition:leave-start="opacity-100 scale-100"
          x-transition:leave-end="opacity-0 scale-90"
        >
          <button
            type="button"
            class="icon-btn absolute top-1 right-1 bg-white/80 rounded-full p-1 print:hidden"
            :disabled="removing.includes(item.id)"
            @click="remove(item.id)"
            aria-label="Remove from saved"
          >
            <Star size={18} class="star-filled" />
          </button>
          <a :href="`/works/${item.id}/`">
            <div class="work-thumbnail-container">
              <img
                :src="item.image"
                :alt="item.title || ''"
                :width="item.width"
                :height="item.height"
                :title="[item.title || 'No title recorded', item.year_start].filter(Boolean).join(', ')"
                class="work-thumbnail"
                loading="lazy"
              />
            </div>
            <div class="pt-1 text-sm text-center">
              <span class="capitalize" x-text="item.title || 'No title recorded'"></span><span x-show="item.year_start" x-text="', ' + item.year_start"></span>
            </div>
          </a>
        </div>
      </template>
    </div>
  </section>
</Layout>

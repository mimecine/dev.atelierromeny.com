---
import "@src/styles/global.css";
import A from "@components/A.astro";
import Barrier from "@components/Barrier.astro";
import SavedStore from "@components/SavedStore.astro";
import Star from "@components/Star.astro";
import { loadSettings } from "@src/lib/settings";
import { renderMarkdown } from "@src/lib/markdown";

import { ClientRouter } from "astro:transitions";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { resolveMedia } from "@src/lib/media";
// Inlined so it takes the text colour (the SVG is drawn in currentColor)
import signature from "@src/media/assets/romeny-signature.svg?raw";
// The logo text as outlines (generated from the logo font), for printing
import logoOutline from "@src/media/assets/atelier-romeny-logo.svg?raw";
import { getCollection } from "astro:content";

interface Props {
  title?: string;
  /** meta description and sharing text; defaults to Settings > Description */
  description?: string;
  /** image for link previews (Facebook, X, iMessage…); defaults to Settings > Sharing Image */
  image?: ImageMetadata | null;
  frontmatter?: Record<string, unknown>;
  bodyclasses?: string | string[];
  slug?: string;
  /** Include this page in site search. Opt-in, so each work is indexed once (its
   *  /works/ page) rather than once per collection it's in. See SearchMeta.astro. */
  searchable?: boolean;
  /** The page's preferred address, when the same content lives at several (a work in
   *  each of its collections); defaults to this page's own path */
  canonical?: string;
  /** Ask search engines not to index this page */
  noindex?: boolean;
  /** Text printed at the top right of every sheet, beside the logo */
  printInfo?: string;
  /** This page's entry in Sveltia CMS, e.g. "works/entries/127-la-serviette-bleue";
   *  shown as an "Edit" link to whoever is signed in to the CMS in this browser */
  cmsPath?: string;
  [key: string]: unknown;
}

const {
  description,
  image,
  frontmatter,
  slug,
  bodyclasses,
  searchable = false,
  noindex = false,
  canonical = Astro.url.pathname,
  printInfo,
  cmsPath,
  title = frontmatter?.title,
  ...props
} = Astro.props;

const collections = await getCollection(
  "collections",
  (collection) => collection.data.published && collection.data.inmenu
);

const {
  menu,
  socials = [],
  barrier,
  ga,
  description: siteDescription,
  share_image,
} = loadSettings();

// Link previews (Open Graph / Twitter cards): a 1200px JPEG, which every service accepts.
const absolute = (path: string) => new URL(path, Astro.site ?? Astro.url).href;
const pageDescription = description || siteDescription;
const shareSource = image ?? resolveMedia(share_image);
const share = shareSource
  ? await getImage({ src: shareSource, width: Math.min(shareSource.width, 1200), format: "jpg" })
  : undefined;
const shareTitle = title ? `${title} - Atelier Romeny` : "Atelier Romeny";

// Printing: the logo, an optional info line, the copyright and the signature sit in
// the page margins (@page margin boxes), so they repeat on every sheet and fit A4 and
// Letter alike. Margin boxes take images and plain text, so the logo and signature go
// in as SVG data URIs, coloured here, and anchored to the outer edges of fixed-width
// boxes with preserveAspectRatio.
const svgDataUri = (svg: string, color: string, width: string, height: string, align: string) =>
  `url("data:image/svg+xml,${encodeURIComponent(
    svg
      .replace(/currentColor/g, color)
      .replace("<svg ", `<svg width="${width}" height="${height}" preserveAspectRatio="${align} meet" `)
  )}")`;
const cssString = (text: string) => `"${text.replace(/\\/g, "\\\\").replace(/"/g, '\\"').replace(/\n/g, " ")}"`;
const printCss = `@media print {
  @page {
    margin: 20mm 12mm 18mm;
    @top-left {
      content: ${svgDataUri(logoOutline, "#2a2622", "60mm", "4.2mm", "xMinYMax")};
      width: 60mm;
      vertical-align: bottom;
      padding-bottom: 4mm;
    }
    ${
      printInfo
        ? `@top-right {
      content: ${cssString(printInfo)};
      font: 700 10pt "Roboto Condensed Variable", "Roboto Condensed", sans-serif;
      color: #2a2622;
      text-align: right;
      vertical-align: bottom;
      padding-bottom: 4mm;
    }`
        : ""
    }
    @bottom-left {
      content: "© ${new Date().getFullYear()} Atelier Romeny";
      font: 300 7pt "Roboto Condensed Variable", "Roboto Condensed", sans-serif;
      color: #737373;
      vertical-align: bottom;
      padding-bottom: 1mm;
    }
    @bottom-right {
      content: ${svgDataUri(signature, "#737373", "50mm", "8.5mm", "xMaxYMax")};
      width: 50mm;
      vertical-align: bottom;
    }
  }
}`;
// Google Analytics (Settings > Google Analytics). Only a well-formed ID is used, since it
// ends up inside a script. Soft navigations (ClientRouter) are counted by GA4's enhanced
// measurement ("page changes based on browser history events", on by default).
const gaId = /^G-[A-Z0-9]+$/.test(ga ?? "") ? ga : undefined;
// Rendered with satteri, which can't run inside the Cloudflare Worker: every page using
// this layout must be prerendered (`export const prerender = true`).
const barrierText = barrier?.enabled ? await renderMarkdown(barrier.text) : "";
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html
  lang="en"
  transition:name="root"
  transition:animate="fade"
  class:list={bodyclasses}
  id={slug && `slug-${slug}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <meta property="og:site_name" content="Atelier Romeny" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={shareTitle} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    <meta property="og:url" content={absolute(canonical)} />
    {
      share && (
        <>
          <meta property="og:image" content={absolute(share.src)} />
          <meta property="og:image:width" content={String(share.attributes.width)} />
          <meta property="og:image:height" content={String(share.attributes.height)} />
          <meta property="og:image:alt" content={title || "Atelier Romeny"} />
        </>
      )
    }
    {/* small images (like the bio portrait) look better as a compact card */}
    <meta name="twitter:card" content={share && share.attributes.width >= 600 ? "summary_large_image" : "summary"} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* The site is also reachable on dev.atelierromeny.com and workers.dev; point search
        engines at the main domain (`site` in astro.config.mjs) */}
    {Astro.site && <link rel="canonical" href={new URL(canonical, Astro.site).href} />}
    <slot name="head" />
    <title>{title && `${title} -`} Atelier Romeny</title>
    <ClientRouter />
    <style is:inline set:html={printCss} />
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',${JSON.stringify(gaId)});`}
          />
        </>
      )
    }
  </head>
  <body
    class="min-h-screen flex flex-col justify-between xgrid xgrid-rows-[auto,1fr,auto]  font-headline font-thin"
    {...props}
  >
    <SavedStore />
    {/* Revealed by cms-link.ts when this browser is signed in to Sveltia (/admin/) */}
    <a
      id="cms-link"
      class="cms-link"
      href={cmsPath ? `/admin/#/collections/${cmsPath}` : "/admin/"}
      title={cmsPath ? "Edit this in the CMS" : "Open the CMS"}
      hidden
    >
      {cmsPath ? "Edit" : "CMS"}
    </a>
    {
      barrier?.enabled && barrier.password && (
        <Barrier password={barrier.password} days={barrier.days || 7} text={barrierText} />
      )
    }
    <header class:list={["site-header", isHome && "is-home"]}>
      <h1 data-pagefind-ignore class="logo" transition:name="site-logo"><a href="/">Atelier Romeny</a></h1>
      <nav class="site-nav print:hidden" x-data transition:name="site-nav">
        {
          menu.map((item) => (
            <A href={`${item.href}`} class="hover:text-gray-500">
              {item.title}
            </A>
          ))
        }
        <a
          href="/saved"
          x-cloak
          x-show="$store.saved.ids.length > 0"
          class="text-gray-700 hover:text-gray-500"
          title="Saved works"
          aria-label="Saved works"
        >
          <Star size={20} class="star-filled" />
        </a>
        <slot name="nav" />
      </nav>
      <slot name="header" />
    </header>
    <main class="flex-1" data-pagefind-body={searchable ? "" : undefined}>
      <slot />
    </main>
    <footer class:list={["site-footer text-xs text-gray-500 pt-8", { "is-home": isHome }]}>
      <div class="footer-text">
      {
        socials.length > 0 && (
          <ul class="flex flex-wrap gap-x-4 gap-y-1 uppercase tracking-wide print:hidden">
            {socials.map((link) => {
              const external = /^https?:/.test(link.href);
              return (
                <li>
                  <a
                    href={link.href}
                    class="hover:text-gray-900"
                    {...(external && { target: "_blank", rel: "noopener" })}
                  >
                    {link.title}
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
      <p class="!pt-1">&copy; {new Date().getFullYear()} Atelier Romeny</p>
      <slot name="footer" />
      </div>
      <div class="signature" role="img" aria-label="Romeny" set:html={signature} />
    </footer>
  </body>
</html>

<script>
  import "@src/lib/thumb-loading";
  import "@src/lib/cms-link";
</script>

<style is:global>
  @reference "../styles/global.css";
  html {
    @apply h-full;
  }
  /* min-height (not height), so long pages push the footer down instead of running under it */
  body {
    @apply m-0 w-full min-h-full p-4 **:[p]:py-2;
    /* Seamless paper tile (800px, shown at half size so the grain stays fine), faded
       with a cream wash on top. Raise --paper-fade towards 1 to make it fainter. */
    --paper-fade: 0.5;
    background:
      linear-gradient(rgb(250 248 243 / var(--paper-fade)), rgb(250 248 243 / var(--paper-fade))),
      #f1ece2 url("../media/assets/paper-tile.jpg") repeat;
    background-size: auto, 400px 400px;
  }

  /* Home: large logo centred over the menu. Other pages: small logo in the left
     corner, menu centred on the page, pushing right when there isn't room. */
  .site-header {
    @apply flex flex-col gap-y-3 pb-4;
  }

  /* Footer: links and copyright with Edlef's signature beside them, bottom right.
     Home: the text stays centred on the page and the signature sits in the corner
     (stacked below it on phones). Other pages: text and signature both on the right. */
  .site-footer {
    @apply flex flex-wrap items-end justify-end gap-x-6 gap-y-3;
  }
  .site-footer .footer-text {
    @apply flex flex-col items-end;
  }
  .site-footer.is-home {
    @apply grid grid-cols-1 sm:grid-cols-[1fr_auto_1fr];
  }
  .site-footer.is-home .footer-text {
    @apply items-center sm:col-start-2;
  }
  .site-footer.is-home .signature {
    @apply justify-self-end;
  }
  /* "Edit" link for whoever is signed in to the CMS (see cms-link.ts) */
  .cms-link {
    position: fixed;
    top: 10px;
    right: 10px;
    z-index: 60;
    padding: 4px 12px;
    border-radius: 999px;
    background: rgb(30 30 30 / 0.75);
    color: #fff;
    font: 600 12px/1.4 system-ui, sans-serif;
    text-decoration: none;
    opacity: 0.7;
    transition: opacity 0.15s;
  }
  .cms-link:hover {
    opacity: 1;
  }
  /* Pencil grey, like a signature on paper (neutral: Tailwind's gray is bluish) */
  .signature {
    @apply text-neutral-500;
  }
  .signature svg {
    @apply block h-10 sm:h-14 w-auto;
  }
  .site-header .logo {
    @apply font-logo font-normal tracking-normal leading-none p-0;
    /* Slightly sunk into the paper: the upper-left rim of each letter is in shadow,
       the lower-right rim catches the light. In em, so it scales with the logo.
       Ink a touch lighter than black, warm to match the paper. */
    color: #2a2622;
    text-shadow:
      min(-1px, -0.007em) min(-1px, -0.007em) max(1px, 0.008em) rgb(40 28 12 / 0.22),
      max(1px, 0.007em) max(1px, 0.007em) 0 rgb(255 255 255 / 0.6);
    font-size: 1.0625rem; /* 15% below text-xl */
  }
  @media (min-width: 48rem) {
    .site-header .logo {
      font-size: 1.275rem; /* 15% below text-2xl */
    }
  }
  .site-nav {
    @apply flex flex-wrap items-center gap-x-6 gap-y-2 md:gap-x-8 uppercase text-lg;
  }
  @media (min-width: 48rem) {
    .site-header:not(.is-home) {
      display: grid;
      grid-template-columns: minmax(max-content, 1fr) auto 1fr;
      align-items: center;
      column-gap: 2rem;
    }
  }
  .site-header.is-home {
    @apply items-center text-center gap-y-6 py-8 md:py-12;
  }
  .site-header.is-home {
    container-type: inline-size;
  }
  .site-header.is-home .logo {
    /* Exactly as wide as the content below it: the front page sections are at most
       72rem (max-w-6xl) with 1rem padding (p-4). The text is 10.606em wide in this
       font (measured), so divide by that. Re-measure if the text or font changes. */
    font-size: calc((min(100cqi, 72rem) - 2rem) / 10.606);
    white-space: nowrap;
  }
  .site-header.is-home .site-nav {
    @apply justify-center;
  }

  /* Work pages are exactly one screen tall: the image takes what's left, so the
     prev/next bar sits at the bottom and nothing moves between works. */
  html.work-page body {
    height: 100dvh;
    min-height: 0;
  }
  html.work-page main {
    @apply flex flex-col min-h-0;
  }
  html.work-page footer {
    @apply pt-2;
  }

  /* Printing (work pages and the Saved page): no menu, pager, footer links or
     buttons; the paper texture is left out by the browser. */
  @media print {
    @page {
      margin: 12mm;
    }
    body {
      @apply p-0;
    }
    /* A work page prints on one sheet: the painting fills what the header, info
       line and footer leave. */
    html.work-page body {
      height: 100vh;
    }
    /* (their own display rules would otherwise win over Tailwind's print:hidden) */
    #logout-link,
    #password-overlay,
    #cms-link,
    .site-header,
    .site-footer,
    .icon-btn {
      display: none !important;
    }
    /* Keep headings with the text or image that follows them */
    h2, h3, h4 {
      break-after: avoid;
    }
    .md-figure {
      break-inside: avoid;
    }
    /* Saved page: two across, never split a work over two sheets */
    .works-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }
    .work-item {
      break-inside: avoid;
    }
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    @apply font-bold font-headline tracking-tighter uppercase text-lg;
  }
  h1 {
    @apply text-3xl lg:text-4xl;
  }
  h2 {
    @apply text-2xl lg:text-3xl;
  }
  h3 {
    @apply text-xl lg:text-2xl;
  }
  h4 {
    @apply text-lg lg:text-xl;
  }
  p > a {
    @apply text-gray-700 hover:text-gray-500 underline;
  }
</style>

---
import "@src/styles/global.css";
import A from "@components/A.astro";
import Barrier from "@components/Barrier.astro";
import SavedStore from "@components/SavedStore.astro";
import { loadSettings } from "@src/lib/settings";
import { renderMarkdown } from "@src/lib/markdown";

import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  frontmatter?: Record<string, unknown>;
  bodyclasses?: string | string[];
  slug?: string;
  /** Include this page in site search. Opt-in, so each work is indexed once (its
   *  /_works/ page) rather than once per collection it's in. See SearchMeta.astro. */
  searchable?: boolean;
  /** Ask search engines not to index this page */
  noindex?: boolean;
  [key: string]: unknown;
}

const {
  description,
  image,
  frontmatter,
  slug,
  bodyclasses,
  searchable = false,
  noindex = false,
  title = frontmatter?.title,
  ...props
} = Astro.props;

const collections = await getCollection(
  "collections",
  (collection) => collection.data.published && collection.data.inmenu
);

const { menu, socials = [], barrier, ga } = loadSettings();
// Google Analytics (Settings > Google Analytics). Only a well-formed ID is used, since it
// ends up inside a script. Soft navigations (ClientRouter) are counted by GA4's enhanced
// measurement ("page changes based on browser history events", on by default).
const gaId = /^G-[A-Z0-9]+$/.test(ga ?? "") ? ga : undefined;
// Rendered with satteri, which can't run inside the Cloudflare Worker: every page using
// this layout must be prerendered (`export const prerender = true`).
const barrierText = barrier?.enabled ? await renderMarkdown(barrier.text) : "";
const isHome = Astro.url.pathname === "/";
---

<!doctype html>
<html
  lang="en"
  transition:name="root"
  transition:animate="fade"
  class:list={bodyclasses}
  id={slug && `slug-${slug}`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {/* The site is also reachable on dev.atelierromeny.com and workers.dev; point search
        engines at the main domain (`site` in astro.config.mjs) */}
    {Astro.site && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />}
    <slot name="head" />
    <title>{title && `${title} -`} Atelier Romeny</title>
    <ClientRouter />
    {
      gaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />
          <script
            is:inline
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',${JSON.stringify(gaId)});`}
          />
        </>
      )
    }
  </head>
  <body
    class="min-h-screen flex flex-col justify-between xgrid xgrid-rows-[auto,1fr,auto]  font-headline font-thin"
    {...props}
  >
    <SavedStore />
    {
      barrier?.enabled && barrier.password && (
        <Barrier password={barrier.password} days={barrier.days || 7} text={barrierText} />
      )
    }
    <header class:list={["site-header", isHome && "is-home"]}>
      <h1 data-pagefind-ignore class="logo" transition:name="site-logo"><a href="/">Atelier Romeny</a></h1>
      <nav class="site-nav" x-data transition:name="site-nav">
        {
          menu.map((item) => (
            <A href={`${item.href}`} class="hover:text-gray-500">
              {item.title}
            </A>
          ))
        }
        <a
          href="/saved"
          x-cloak
          x-show="$store.saved.ids.length > 0"
          class="text-gray-700 hover:text-gray-500"
          title="Saved works"
          aria-label="Saved works"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 3.5h12a.5.5 0 0 1 .5.5v17l-6.5-4-6.5 4v-17a.5.5 0 0 1 .5-.5Z" />
          </svg>
        </a>
        <slot name="nav" />
      </nav>
      <slot name="header" />
    </header>
    <main class="flex-1" data-pagefind-body={searchable ? "" : undefined}>
      <slot />
    </main>
    <footer
      class:list={[
        "text-xs text-gray-500 flex flex-col pt-8",
        isHome ? "items-center" : "items-end",
      ]}
    >
      {
        socials.length > 0 && (
          <ul class="flex flex-wrap gap-x-4 gap-y-1 uppercase tracking-wide">
            {socials.map((link) => {
              const external = /^https?:/.test(link.href);
              return (
                <li>
                  <a
                    href={link.href}
                    class="hover:text-gray-900"
                    {...(external && { target: "_blank", rel: "noopener" })}
                  >
                    {link.title}
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
      <p class="!pt-1">&copy; {new Date().getFullYear()} Atelier Romeny</p>
      <slot name="footer" />
    </footer>
  </body>
</html>

<script>
  import "@src/lib/thumb-loading";
</script>

<style is:global>
  @reference "../styles/global.css";
  html {
    @apply h-full;
  }
  /* min-height (not height), so long pages push the footer down instead of running under it */
  body {
    @apply m-0 w-full min-h-full p-4 !bg-gray-50 **:[p]:py-2;
  }

  /* Home: large logo centred over the menu. Other pages: small logo in the left
     corner, menu centred on the page, pushing right when there isn't room. */
  .site-header {
    @apply flex flex-col gap-y-3 pb-4;
  }
  .site-header .logo {
    @apply font-logo font-normal tracking-normal leading-none text-xl md:text-2xl p-0;
  }
  .site-nav {
    @apply flex flex-wrap items-center gap-x-6 gap-y-2 md:gap-x-8 uppercase text-lg;
  }
  @media (min-width: 48rem) {
    .site-header:not(.is-home) {
      display: grid;
      grid-template-columns: minmax(max-content, 1fr) auto 1fr;
      align-items: center;
      column-gap: 2rem;
    }
  }
  .site-header.is-home {
    @apply items-center text-center gap-y-6 py-8 md:py-12;
  }
  .site-header.is-home .logo {
    font-size: clamp(2.5rem, 9vw, 8rem);
  }
  .site-header.is-home .site-nav {
    @apply justify-center;
  }

  /* Work pages are exactly one screen tall: the image takes what's left, so the
     prev/next bar sits at the bottom and nothing moves between works. */
  html.work-page body {
    height: 100dvh;
    min-height: 0;
  }
  html.work-page main {
    @apply flex flex-col min-h-0;
  }
  html.work-page footer {
    @apply pt-2;
  }
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    @apply font-bold font-headline tracking-tighter uppercase text-lg;
  }
  h1 {
    @apply text-3xl lg:text-4xl;
  }
  h2 {
    @apply text-2xl lg:text-3xl;
  }
  h3 {
    @apply text-xl lg:text-2xl;
  }
  h4 {
    @apply text-lg lg:text-xl;
  }
  p > a {
    @apply text-gray-700 hover:text-gray-500 underline;
  }
</style>

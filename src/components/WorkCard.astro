---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { workTransitionName } from "@src/lib/view-transition";
import { thumbnailOf, titleOf } from "@src/lib/works";

interface Props {
  work: CollectionEntry<"works">;
  /** collection the card links into (also scopes the view transition) */
  collection: string;
  /** use this thumbnail as the page's image in search results */
  searchImage?: boolean;
}

const { work, collection, searchImage } = Astro.props;
const thumbnail = thumbnailOf(work);
---

<a
  href={`/${collection}/${work.id}`}
  title={[titleOf(work), work.data.year_start].filter(Boolean).join(", ")}
>
  <div class="work-item" data-key={work.id}>
    <div class="work-thumbnail-container">
      {
        thumbnail && (
          <Image
            src={thumbnail}
            alt={work.data.title || ""}
            width={600}
            class="work-thumbnail"
            data-pagefind-meta={searchImage ? "image[src]" : undefined}
            style={`view-transition-name: ${workTransitionName(collection, work.id)}`}
          />
        )
      }
    </div>
  </div>
</a>

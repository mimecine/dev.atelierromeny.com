---
// Client-side password gate, configured in Settings > Password Protection.
// Keeps casual visitors out; it is not real security (the password is in the page).
interface Props {
  password: string;
  days?: number;
  /** optional HTML shown under the password field */
  text?: string;
}
const { password, days = 7, text } = Astro.props;
---
<div id="password-overlay" transition:persist data-pagefind-ignore>
  <h2>Enter password</h2>
  <form id="pw-form">
    <input id="pw-input" type="password" />
    <button id="pw-btn" type="submit">Submit</button>
  </form>
  <p id="pw-error">Wrong password</p>
  {text && <div id="pw-text" class="prose prose-invert prose-sm" set:html={text} />}
</div>
<a id="logout-link" href="#" transition:persist>Logout</a>

<script define:vars={{password, days}}>
(function () {
  const PASSWORD = password;
  const COOKIE_NAME = "access_granted";
  const COOKIE_DAYS = days; // days until cookie expires. (1/24 = 1 hour)
  // The cookie holds a hash of the password, so changing the password in the
  // CMS logs everyone out instead of old cookies still letting them in.
  let hash = 5381;
  for (const c of PASSWORD) hash = ((hash * 33) ^ c.charCodeAt(0)) >>> 0;
  const COOKIE_VALUE = "v" + hash.toString(36);

  function setCookie(name, value, days) {
    const d = new Date();
    d.setTime(d.getTime() + (COOKIE_DAYS*24*60*60*1000));
    document.cookie = `${name}=${value}; expires=${d.toUTCString()}; path=/`;
  }

  function getCookie(name) {
    return document.cookie.split('; ').find(r => r.startsWith(name+"="))?.split('=')[1];
  }

  function deleteCookie(name) {
    document.cookie = `${name}=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;`;
  }

  // Runs on every client-side navigation. The overlay and logout link are
  // transition:persist, so the same nodes (already hidden for a logged-in
  // visitor) carry across pages instead of fresh, visible ones flashing up
  // during the view transition. Their listeners are bound only once.
  function init() {
    const overlay = document.getElementById("password-overlay");
    const logoutLink = document.getElementById("logout-link");

    if (getCookie(COOKIE_NAME) === COOKIE_VALUE) {
      overlay.style.display = "none";
      logoutLink.style.display = "inline-block";
    } else {
      overlay.style.display = "flex";
      logoutLink.style.display = "none";
    }

    if (overlay.dataset.bound) return;
    overlay.dataset.bound = "true";

    document.getElementById("pw-form").addEventListener("submit", (e) => {
      e.preventDefault();
      const pw = document.getElementById("pw-input").value;
      if (pw === PASSWORD) {
        setCookie(COOKIE_NAME, COOKIE_VALUE, COOKIE_DAYS);
        overlay.style.display = "none";
        logoutLink.style.display = "inline-block";
      } else {
        document.getElementById("pw-error").style.display = "block";
      }
    });

    logoutLink.addEventListener("click", (e) => {
      e.preventDefault();
      deleteCookie(COOKIE_NAME);
      overlay.style.display = "flex";
      logoutLink.style.display = "none";
    });
  }

  init();
  document.addEventListener("astro:page-load", init);
})();
</script>

<style>
  #password-overlay {
    position: fixed;
    inset: 0;
    background: #111;
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }

  #pw-input {
    padding: 0.5em;
    margin: 1em;
    font-size: 1em;
    background: #eee;
    color: #222;
    border: 1px solid #8c8a8a;
  }

  #pw-btn {
    padding: 0.5em 1em;
    font-size: 1em;
  }

  #pw-error {
    color: tomato;
    display: none;
  }

  #logout-link {
    position: fixed;
    top: 10px;
    right: 10px;
    color: #fff;
    background: #333;
    padding: 0.4em 0.8em;
    border-radius: 6px;
    text-decoration: none;
    display: none;
    z-index: 10000;
    font-size: 0.9em;
  }

  #pw-text {
    max-width: 32rem;
    padding: 1.5em 1em 0;
    text-align: center;
  }
  #pw-text :global(a) {
    color: #ddd;
    text-decoration: underline;
  }

  #pw-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1em;
  }
</style>





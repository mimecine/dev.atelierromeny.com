---
import SectionHeader from "./SectionHeader.astro";
import { renderMarkdown } from "@src/lib/markdown";
import type { Section } from "@src/lib/settings";

interface Props {
  section: Section;
}
const { section } = Astro.props;
const html = await renderMarkdown(section.text);
const columns = Number(section.columns) || 1;
---

{
  (html || (section.show_title && section.header)) && (
    <section class="w-full max-w-6xl mx-auto p-4 font-serif">
      <SectionHeader title={section.header} show={section.show_title} />
      <div
        class:list={[
          "prose prose-lg gap-8 [&_img]:break-inside-avoid",
          { "max-w-none": columns > 1, "md:columns-2": columns === 2, "md:columns-3": columns === 3 },
        ]}
        set:html={html}
      />
    </section>
  )
}

---
import { getCollection, getEntry } from "astro:content";
import WorksGrid from "./WorksGrid.astro";
import { isShown } from "@src/lib/works";
import { sortWorks } from "@src/lib/sections";
import type { Section } from "@src/lib/settings";

interface Props {
  section: Section;
}
const { section } = Astro.props;
const id = String(section.collection);
const collection = await getEntry("collections", id);
const works = collection?.data.published
  ? sortWorks(await getCollection("works", (w) => isShown(w) && !!w.data.collections?.includes(id)), section.sort)
  : [];
const columns = Math.min(Math.max(Number(section.columns) || 3, 1), 6);
// "Number of works" wins; older sections may still use "Max rows"
const limit = Number(section.limit) || (Number(section.max_rows) || 0) * columns;
---

<WorksGrid
  title={section.title || collection?.data.title}
  showTitle={section.show_title}
  works={works}
  columns={columns}
  limit={limit}
  linkCollection={id}
  more={{ href: `/${id}/`, label: section.more_label }}
/>

---
// A photo from /photos/ mixed into a work grid as an accent, shown whole: landscape
// photos span two columns, portrait ones one. Links to the photo's page.
import { Image } from "astro:assets";
import type { Photo } from "@src/lib/photos";

interface Props {
  photo: Photo;
}
const { photo } = Astro.props;
const { title, image, caption } = photo.data;
const wide = image.width / image.height > 1.2;
---

<a href={`/photos/${photo.id}/`} class:list={["photo-card", { wide }]} title={caption || title}>
  <Image src={image} alt={caption || title} width={wide ? 1000 : 600} />
</a>

<style>
  /* Fills the grid cell(s) without making the row taller: the image is taken out of the
     flow and fitted (whole, centred) into the space the work cards give the row. */
  .photo-card {
    display: block;
    position: relative;
    min-height: 8rem;
  }
  .photo-card.wide {
    grid-column: span 2;
  }
  .photo-card :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 0.2s;
  }
  .photo-card:hover :global(img) {
    opacity: 0.9;
  }
</style>

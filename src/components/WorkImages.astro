---
import type { CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import { imagesOf, thumbnailIndex } from "@src/lib/works";

interface Props {
  work: CollectionEntry<"works">;
  /** view-transition-name for the first image (matches the grid thumbnail it came from) */
  transitionName?: string;
}

const { work, transitionName } = Astro.props;
const alt = work.data.title || "";
// The detail (artwork alone, straightened) comes last in the strip; it isn't one of the
// images grids and the thumbnail choice pick from.
const gallery = [...imagesOf(work), ...(work.data.detail ? [work.data.detail] : [])];
// The chosen thumbnail is also the image shown for this page in search results.
// The page opens on the chosen thumbnail (the image shown for this work in grids and
// search results); the strip below keeps the saved order.
const start = thumbnailIndex(work);
const searchIndex = start;
// Larger versions for the zoom viewer; only downloaded when it's opened.
const zoomSrcs = await Promise.all(
  gallery.map(
    async (img) => (await getImage({ src: img, width: Math.min(img.width, 3000) })).src
  )
);
---

<!--
  Fills whatever height its parent gives it (the image is absolutely positioned inside a
  flexible box), and the thumbnail band keeps its height on desktop even when there's only
  one image, so paging between works never shifts the layout.
-->
<div class="flex flex-col flex-1 min-h-0" x-data={`{ active: ${start} }`}>
  <div class="relative flex-1 min-h-0">
    {
      (gallery.length > 0 &&
        gallery.map((img, i) => (
          <Image
            src={img}
            alt={alt}
            width={1024}
            class="absolute inset-0 w-full h-full object-contain cursor-zoom-in"
            data-zoom-src={zoomSrcs[i]}
            data-pagefind-meta={i === searchIndex ? "image[src]" : undefined}
            title="Click to zoom"
            x-show={`active === ${i}`}
            style={
              i !== start
                ? "display: none"
                : transitionName && `view-transition-name: ${transitionName}`
            }
          />
        ))) || (
        <div class="absolute inset-0 grid place-content-center bg-gray-200 border">
          Image missing
        </div>
      )
    }
  </div>
  <ul
    class:list={[
      "flex justify-center items-center gap-2 h-15 pt-3 shrink-0 print:hidden",
      gallery.length < 2 && "max-md:hidden",
    ]}
  >
    {
      gallery.length > 1 &&
        gallery.map((img, i) => (
          <li>
            <button
              type="button"
              class="block border transition-opacity"
              :class={`active === ${i} ? 'border-black opacity-100' : 'border-transparent opacity-50 hover:opacity-100'`}
              @click={`active = ${i}`}
              aria-label={`Image ${i + 1} of ${gallery.length}`}
            >
              <Image src={img} alt="" width={96} class="h-12 w-auto object-contain" />
            </button>
          </li>
        ))
    }
  </ul>
</div>

<script>
  import { initZoom } from "@src/lib/zoom";
  initZoom();
</script>
